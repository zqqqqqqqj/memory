# Only explicitly listed source/configuration directories may enter this repo.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/EXPORT_MANIFEST.json
!/src/
!/scripts/
!/tests/
!/configs/
!/ablation_memory_capacity/
!/ablation_residual_memory/
!/ablation_optimization/

# Runtime artifacts and credentials are excluded at every depth.
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/data/
**/runs/
**/checkpoints/
**/wandb/
**/.venv*/
**/.env
**/.env.*
**/server.local.yaml
*.pyc
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.parquet
*.h5
*.hdf5
*.mp4
*.avi
*.png
*.jpg
*.jpeg
*.tar
*.gz
*.zip
*.log
*.jsonl
*.key
*.pem
